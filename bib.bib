% For theses, particularly in Norway, search for the "https://hdl.handle.net/" and use that for "URL" to ensure you use a permanent link.
@thesis{LastName2045norwegian,
  author      = {FirstName LastName},
  institution = {Norwegian University of Life Sciences},
  title       = {Norwegian Hydropower Development Strategies: An Analysis of Private Investments between 2010--2020},
  type        = {Master's thesis},
  url         = {https://hdl.handle.net/00000/0000000},
  year        = 2045
}

% The authors name can be written as "last name, first name" (with a comma in between)
@thesis{Temult2038binding,
  author      = {Temult, Liliana},
  institution = {Norwegian University of Life Sciences},
  title       = {Binding strategies in molecular dynamical modelling with Monte Carlo simulations},
  type        = {PhD thesis},
  url         = {https://hdl.handle.net/00000/0000000},
  year        = 2038
}

% For articles, you should always find the DOI and use "doi" in the bib. The DOI (digital object identifier) is a permanent link to an article. If you have a DOI, you should remove any URLs.
% To separate authors, use "and". Commas cannot be used to separate authors.
@article{Beck2005timeseries,
  author    = {Beck, Christian and Cohen, Ezechiel G. D. and Swinney, Harry L.},
  doi       = {10.1103/PhysRevE.72.056133},
  journal   = {Physical Review E},
  number    = {5},
  pages     = {056133},
  publisher = {American Physical Society},
  title     = {From Time Series to Superstatistics},
  volume    = {72},
  year      = {2005}
}

% All articles have a "volume" and most have at least a "number", an "issue", and "pages".
@article{Beck2000application,
  author  = {Beck, Christian},
  doi     = {10.1016/S0378-4371(99)00508-7},
  issn    = {0378-4371},
  journal = {Physica A: Statistical Mechanics and its Applications},
  number  = {1},
  pages   = {115--123},
  title   = {Application of Generalized Thermostatistics to Fully Developed Turbulence},
  volume  = {277},
  year    = {2000}
}

% For books you need to include as well the "publisher", e.g. "Springer", and a location, e.g. "Berlin".
% You must also include the ISBN (preferably the ISBN-13, which has 13 numbers). If the book has a DOI, include it as well.
% Lastly, you should include the book edition, "1" in this case. Note that some bibliography styles only show the edition if it is not the first edition.
@book{Abe2001nonextensive,
  author    = {Sumiyoshi Abe and Yuko Okamoto},
  doi       = {10.1007/3-540-40919-X},
  edition   = {1},
  isbn      = {978-3-540-41208-3},
  location  = {Berlin},
  publisher = {Springer},
  title     = {Nonextensive Statistical Mechanics and Its Applications},
  year      = {2001}
}

% Some "articles" are known as "proceedings" as they are the proceedings of a conference. These usually have a "booktitle" as they are published as part of a book. Most of the time, they do not have a volume or number, but they should always have a DOI.
@inproceedings{Milano2018,
  author    = {Milano, Federico and D\"orfler, Florian and Hug, Gabriela and Hill, David J. and Verbi{\v{c}}, Gregor},
  booktitle = {2018 Power Systems Computation Conference (PSCC)},
  doi       = {10.23919/PSCC.2018.8450880},
  number    = {},
  pages     = {1--25},
  title     = {Foundations and Challenges of Low-Inertia Systems (Invited Paper)},
  volume    = {},
  year      = {2018}
}

% Some proceedings, particularly in computer science, do not have a DOI. Try to always include a URL to the proceedings if there is no DOI so the reader can easily find the work.
@inproceedings{Jozefowicz2015empirical,
  author    = {Jozefowicz, Rafal and Zaremba, Wojciech and Sutskever, Ilya},
  booktitle = {International Conference on Machine Learning},
  pages     = {2342--2350},
  title     = {An empirical exploration of recurrent network architectures},
  url       = {https://proceedings.mlr.press/v37/jozefowicz15.html},
  volume    = {37},
  year      = {2015}
}

